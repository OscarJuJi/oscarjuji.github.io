{
  "name": "educator-js-codespace-template",
  "version": "1.0.0",
  "description": "A digital Portfolio",
  "source": "src/index.html",
  "homepage": "http://OscarJuJi.github.io",
  "scripts": {
    "start": "parcel",
    "clean": "rm -rf dist .parcel-cache",
    "build": "npm run clean && parcel build && npm run copy-static",
    "build-gh": "npm run clean && parcel build --public-url 'https://OscarJuJi.github.io' && npm run copy-static",
    "copy-static": "cp public/robots.txt public/sitemap.xml dist/ && touch dist/.nojekyll",
    "predeploy": "npm run build-gh",
    "deploy": "gh-pages -d dist -t",
    "test:filter": "node scripts/test-filter.mjs",
    "test:chat": "node scripts/test-chat.mjs",
    "test": "npm run test:filter && npm run test:chat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/codespaces-teaching-template-js.git"
  },
  "author": "Microsoft",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/microsoft/codespaces-teaching-template-js/issues"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bootstrap": "^5.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^9.2.1"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.7.0",
    "@parcel/transformer-jsonld": "^2.7.0",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.7",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.5.0",
    "parcel": "^2.7.0",
    "prettier": "^2.7.1",
    "process": "^0.11.10"
  }
}
